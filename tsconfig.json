{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "strict": true,
    // @react-native/typescript-config ships no DOM lib; this app's web-facing
    // code (fetch/BodyInit/AbortSignal/ReadableStream, the Vercel AI SDK, viem)
    // needs it — expo/tsconfig.base used to provide it.
    "lib": ["esnext", "dom", "dom.iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/components/*": [
        "src/components/*"
      ],
      "@/screens/*": [
        "src/screens/*"
      ],
      "@/hooks/*": [
        "src/hooks/*"
      ],
      "@/stores/*": [
        "src/stores/*"
      ],
      "@/navigation/*": [
        "src/navigation/*"
      ],
      "@/i18n/*": [
        "src/i18n/*"
      ],
      "@/config/*": [
        "src/config/*"
      ],
      "@/context/*": [
        "src/context/*"
      ],
      "@/polyfills/*": [
        "src/polyfills/*"
      ],
      "@/services/*": [
        "src/services/*"
      ],
      "@/native/*": [
        "src/native/*"
      ],
      "@/di/*": [
        "src/di/*"
      ],
      "@/assets/*": [
        "assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}